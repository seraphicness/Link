diff --git a/net/minecraft/network/PacketProcessor.java b/net/minecraft/network/PacketProcessor.java
index 408cb99..341f781 100644
--- a/net/minecraft/network/PacketProcessor.java
+++ b/net/minecraft/network/PacketProcessor.java
@@ -90,12 +90,18 @@ public class PacketProcessor implements AutoCloseable {
 
     private record ListenerAndPacket<T extends PacketListener>(T listener, Packet<T> packet) {
         public void handle() {
+            if (this.listener instanceof net.minecraft.server.network.ServerGamePacketListenerImpl game && io.linkmc.server.NativeJournal.moving(game.player.getUUID())) return;
+            io.linkmc.server.NativeJournal.run(this::linkHandle);
+        }
+
+        private void linkHandle() {
             packetProcessing.push(this.listener); // Paper - detailed watchdog information
             try { // Paper - detailed watchdog information
             if (this.listener.shouldHandleMessage(this.packet)) {
                 try {
                     this.packet.handle(this.listener);
                 } catch (Exception e) {
+                    if (io.linkmc.server.NativeJournal.enabled()) throw new IllegalStateException("Native packet execution failed", e);
                     if (e instanceof ReportedException re && re.getCause() instanceof OutOfMemoryError) {
                         throw PacketUtils.makeReportedException(e, this.packet, this.listener);
                     }
