Subject: [PATCH] Bootstrap journal worlds without vanilla level.dat

diff --git a/net/minecraft/server/Main.java b/net/minecraft/server/Main.java
index aa7f2ba..908d0f4 100644
--- a/net/minecraft/server/Main.java
+++ b/net/minecraft/server/Main.java
@@ -197,7 +197,7 @@ public class Main {
             LevelStorageSource levelStorageSource = LevelStorageSource.createDefault(universePath.toPath());
             LevelStorageSource.LevelStorageAccess access = levelStorageSource.validateAndCreateAccess(levelName);
             Dynamic<?> levelDataTag;
-            if (access.hasWorldData()) {
+            if (access.hasWorldData() && !System.getProperty("link.mode", "disabled").equals("journal")) {
                 Dynamic<?> levelDataUnfixed;
                 try {
                     levelDataUnfixed = access.getUnfixedDataTagWithFallback();
diff --git a/net/minecraft/world/level/storage/LevelStorageSource.java b/net/minecraft/world/level/storage/LevelStorageSource.java
index 01b4ea4..518ec14 100644
--- a/net/minecraft/world/level/storage/LevelStorageSource.java
+++ b/net/minecraft/world/level/storage/LevelStorageSource.java
@@ -583,6 +583,7 @@ public class LevelStorageSource {
         }
 
         public void saveDataTag(final WorldData levelData, final @Nullable UUID singleplayerUUID) {
+            if (io.linkmc.server.NativeJournal.enabled()) return;
             CompoundTag dataTag = levelData.createTag(singleplayerUUID);
             CompoundTag root = new CompoundTag();
             root.put("Data", dataTag);
